{
  "name": "ledgerly-ci",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -b",
    "test": "yarn test:unit && yarn test:component",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:watch": "vitest --project unit --project component",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "start-server-and-test dev http://localhost:5173 'cypress run'",
    "test:e2e:open": "start-server-and-test dev http://localhost:5173 'cypress open'",
    "test:e2e:ci": "start-server-and-test 'vite preview --port 4173 --strictPort' http://localhost:4173 'cypress run --config baseUrl=http://localhost:4173'",
    "build:files": "tsc -b && vite build",
    "build": "yarn build:files",
    "build:develop": "tsc -b && vite build --mode develop",
    "build:main": "tsc -b && vite build --mode main",
    "verify": "yarn lint && yarn typecheck && yarn test && yarn build",
    "verify:all": "yarn verify && yarn test:e2e:ci",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.100.14",
    "clsx": "^2.1.1",
    "formik": "^2.4.9",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.16.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "yup": "^1.7.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^5.1.0",
    "cypress": "^15.17.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "start-server-and-test": "^3.0.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^5.1.0"
  }
}
